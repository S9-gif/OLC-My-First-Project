# Database Connection (Neon, Supabase, vb. ücretsiz bir Postgres sağlayıcısından alın)
DATABASE_URL=postgresql://user:password@host/database_name

# API Settings
PROJECT_NAME=OLC - Open Learn Close
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key

# AI API Keys (opsiyonel - USE_REAL_AI=False iken gerekmez)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
